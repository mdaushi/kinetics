{
    "name": "mdaushi/kinetics",
    "type": "library",
    "keywords": [
        "laravel",
        "inertia",
        "datatable",
        "server-side"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0||^13.0",
        "illuminate/http": "^12.0||^13.0",
        "illuminate/pagination": "^12.0||^13.0",
        "illuminate/support": "^12.0||^13.0"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Kinetics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kinetics\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs --standard=PSR12 src/",
        "lint:fix": "phpcbf --standard=PSR12 src/"
    },
    "authors": [
        {
            "name": "Muhammad Firdaus"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "Kinetics\\KineticsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "packages/react/src",
            "packages/react/node_modules",
            "packages/react/tsup.config.ts",
            "packages/react/tsconfig.json",
            "packages/react/tailwind.config.js",
            "packages/react/package-lock.json",
            "packages/core/src",
            "packages/core/node_modules",
            "packages/core/tsconfig.json",
            "packages/vue",
            "tests",
            "docs",
            ".phpunit.cache",
            "phpunit.xml",
            "pnpm-lock.yaml",
            "pnpm-workspace.yaml",
            "package.json"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
